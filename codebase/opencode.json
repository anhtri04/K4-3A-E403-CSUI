{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow"
    },
    "external_directory": "deny"
  },
  "agent": {
    "buildmate-readonly": {
      "mode": "primary",
      "description": "Read-only explainer for BuildMate Discord bot"
    },
    "buildmate-coder": {
      "mode": "primary",
      "description": "Coder for BuildMate propose-diff (edits only, no shell writes)",
      "permission": {
        "edit": "allow"
      }
    }
  }
}
