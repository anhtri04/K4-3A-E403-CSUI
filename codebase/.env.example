# Copy to .env (NEVER commit .env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
DISCORD_TOKEN=
TEAM_REPO_SNAPSHOT=./sample_repo
COURSE_KB_PATH=./course_kb.json
# Phase 2 backend: one `opencode serve` per team (working dir = team snapshot)
# Start: OPENCODE_SERVER_PASSWORD=secret opencode serve --port 4096
BACKEND=local
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode
# Discord user IDs allowed to /approve (CSV). Empty = demo mode (anyone, loudly logged).
APPROVERS=
BUILDMATE_STATE_DIR=./state
